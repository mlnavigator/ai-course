# Скопируйте этот файл в `.env` и заполните значения.
# `.env` в git не попадает (см. .gitignore).

# ---- OpenAI-compatible провайдер ----
# Пример: https://api.openai.com/v1 или любой совместимый endpoint
LLM_API_KEY=replace-me
LLM_BASE_URL=https://provider.example/v1
LLM_MODEL=provider-model-id

# ---- OpenRouter (агрегатор моделей) ----
OPENROUTER_API_KEY=replace-me
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_MODELS=openai/gpt-4o-mini,anthropic/claude-3.5-sonnet